# JOCKY Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Optional / Fallback to In-Memory/Local)
MONGODB_URI=mongodb://localhost:27017/jocky_forensics
